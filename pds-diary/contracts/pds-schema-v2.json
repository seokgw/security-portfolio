  "version":"2.0","database":{"name":"pds_diary","engine":"MariaDB","storage_engine":"InnoDB","charset":"utf8mb4","collation":"utf8mb4_unicode_ci","session_timezone":"+09:00","display_timezone":"Asia/Seoul"},"time_unit":"minutes","date_rules":{"DATE":"calendar date without timezone conversion","DATETIME":"MariaDB session time (+09:00)","browser_display":"Asia/Seoul"},
